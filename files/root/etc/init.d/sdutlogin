#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

start_service()
{
	local enable
	enable=$(uci -q get sdutlogin.@login[0].enable 2>/dev/null)
	[ "$enable" != "1" ] && {
		rm -f /tmp/sdutlogin.state /tmp/sdut_wifi_off
		return
	}

	mkdir -p /tmp/log/sdutlogin

	procd_open_instance
	procd_set_param command /usr/lib/sdutlogin/login.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service()
{
	rm -f /tmp/sdutlogin.state /tmp/sdut_wifi_off
}


#!/bin/sh /etc/rc.common

START=99

start()
{
	if [ ! -d /tmp/log/sdutlogin ]; then
		mkdir -p /tmp/log/sdutlogin
	fi
	enable=$(uci -q get sdutlogin.@login[0].enable 2>/dev/null)
	if [ "$enable" != "1" ]; then
		echo "$(date "+%Y-%m-%d %H:%M:%S"): 未启用，不启动"
		return
	fi
	state=$(pgrep -f "/usr/lib/sdutlogin/login.sh")
	if [ -n "$state" ]; then
		restart
	else
		/usr/lib/sdutlogin/login.sh >/dev/null 2>&1 &
	fi
	echo "$(date "+%Y-%m-%d %H:%M:%S"): 已启动"
}

stop()
{
	kill -9 $(pgrep -f "/usr/lib/sdutlogin/login.sh") 2>/dev/null
	echo "$(date "+%Y-%m-%d %H:%M:%S"): 已停止"
}

restart()
{
	stop
	sleep 1
	start
}
